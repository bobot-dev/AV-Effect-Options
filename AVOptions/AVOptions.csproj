<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.1</TargetFramework>
	<LangVersion>preview</LangVersion>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<AssemblyVersion>2.0.0</AssemblyVersion>
	<FileVersion>2.0.0</FileVersion>
  </PropertyGroup>
	
    <ItemGroup>
	    <Compile Remove="NetworkWeaver\**" />
	    <EmbeddedResource Remove="NetworkWeaver\**" />
	    <None Remove="NetworkWeaver\**" />
	    <Compile Remove="Main.cs" />
	    <None Remove="resources\icon.png" />
	    <EmbeddedResource Include="resources\icon.png">
	      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    </EmbeddedResource>
    </ItemGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

	<PropertyGroup>
		<BuildDir>$(SolutionDir)build/</BuildDir>
		<TSPackageDir>$(BuildDir)/package/</TSPackageDir>
		<TSPackagePluginDir>$(TSPackageDir)/plugins/$(SolutionName)/</TSPackagePluginDir>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.20" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="RoR2BepInExPack" Version="1.50.0" />
    <PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" GeneratePathProperty="true" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RiskOfOptions">
      <HintPath>..\lib\RiskOfOptions.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>..\lib\Unity.Postprocessing.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="resources\" />
  </ItemGroup>

 

 <Target Name="PostBuild" AfterTargets="PostBuildEvent">
   <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;C:\Users\user\AppData\Roaming\com.kesomannen.gale\riskofrain2\profiles\hc\BepInEx\plugins\Nuxlar-SOTS_AV_Effect_Options&quot; &#xA;copy /Y &quot;$(TargetPath)&quot; &quot;C:\Users\user\AppData\Roaming\com.kesomannen.gale\riskofrain2\profiles\modding\BepInEx\plugins\Nuxlar-SOTS_AV_Effect_Options&quot;&#xA;copy /Y &quot;$(TargetPath)&quot; &quot;$(ProjectDir)\..\build\package\plugins\AVOptions&quot;" />
 </Target>

</Project>